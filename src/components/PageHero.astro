---
import Kicker from "./Kicker.astro";
interface Props { kicker: string; n?: string }
const { kicker, n } = Astro.props;
---
<section class="relative mx-auto max-w-[1400px] px-4 pt-40 pb-20 sm:px-8 sm:pt-48">
  <div class="tracks pointer-events-none absolute top-24 right-0 h-64 w-1/3 opacity-30 [mask-image:linear-gradient(to_left,black,transparent)]"></div>
  <Kicker n={n}>{kicker}</Kicker>
  <h1 class="display kinetic mt-8 max-w-[14ch] text-[clamp(3.25rem,10vw,9.5rem)]"><slot /></h1>
  <div class="mt-10 max-w-2xl text-lg leading-relaxed text-muted sm:text-xl"><slot name="lede" /></div>
</section>
